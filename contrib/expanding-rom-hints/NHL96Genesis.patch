-        const bad = lines.filter((l) => /\.(asm|inc|mac)\(\d+|error|fatal|not recognised|undefined/i.test(l) && !/error\(s\) from/.test(l)).slice(0, 40);
-        fail('assemble', `${errors} error(s), see ${rel(logPath)}`, bad.join('\n'));
